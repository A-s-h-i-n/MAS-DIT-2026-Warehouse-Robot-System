# Backend configuration (all optional — sensible defaults are built in).
WMS_HOST=0.0.0.0
WMS_PORT=8000
WMS_DB_PATH=backend/database/warehouse.db

# Simulation grid
WMS_GRID_WIDTH=10
WMS_GRID_HEIGHT=10

# Timing: real seconds per simulation tick (1 cell of movement per tick)
WMS_TICK_SECONDS=1.0

# Battery model
WMS_BATTERY_DRAIN=1
WMS_BATTERY_CHARGE=8
WMS_BATTERY_LOW=20
WMS_BATTERY_MIN_TASK=25

# Number of robots (max 5 with the default home layout)
WMS_NUM_ROBOTS=3

# AI-based scheduling via LM Studio (local Mistral, OpenAI-compatible API).
# Off by default — the heuristic scheduler runs without any LLM. Toggle on from
# the dashboard or with POST /ai/toggle. When in Docker, use host.docker.internal.
WMS_AI_SCHEDULING=false
WMS_LMSTUDIO_URL=http://localhost:1234/v1
WMS_LMSTUDIO_MODEL=local-model
WMS_LMSTUDIO_TIMEOUT=8.0

# CORS origins for the dashboard
WMS_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend (build-time): URL the browser uses to reach the backend
VITE_API_URL=http://localhost:8000
